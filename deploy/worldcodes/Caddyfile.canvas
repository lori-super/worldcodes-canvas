# Rendered and installed as /etc/caddy/Caddyfile.canvas. The two __...__
# placeholders are replaced by install-canvas-caddy.sh before validation.
canvas.worldcodes.online {
	root * /opt/worldcodes-canvas/current

	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; media-src 'self' blob: data: https:; font-src 'self' data:; connect-src 'self' data: __R2_ORIGIN__; worker-src 'self' blob:; child-src 'none'; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# One reverse_proxy handler keeps the Relay blue-green upstream count
	# deterministic. Method and path must both match the public Canvas contract.
	@canvasAPI expression `
	(method('GET') && path('/v1/models', '/v1/images/content/*', '/v1/images/tasks/*', '/v1/videos/*')) ||
	(method('POST') && path('/v1/responses', '/v1/audio/speech', '/v1/images/generations', '/v1/images/edits', '/v1/videos', '/v1/media/uploads/presign', '/v1/media/uploads/*', '/v1beta/models/*')) ||
	(method('DELETE') && path('/v1/media/uploads/*'))
	`
	handle @canvasAPI {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:__RELAY_PORT__
	}

	# Never let an unapproved API path fall through to the SPA shell.
	@apiNamespace path /api /api/* /v1 /v1/* /v1beta /v1beta/*
	handle @apiNamespace {
		respond 404
	}

	@immutable path /assets/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@spa method GET HEAD
	handle @spa {
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/worldcodes-canvas.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
