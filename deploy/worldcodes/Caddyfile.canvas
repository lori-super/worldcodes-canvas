# Rendered and installed as /etc/caddy/Caddyfile.canvas. The two __...__
# placeholders are replaced by install-canvas-caddy.sh before validation.
canvas.worldcodes.online {
	root * /opt/worldcodes-canvas/current

	encode zstd gzip

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https: http://127.0.0.1:17371; media-src 'self' blob: data: https: http://127.0.0.1:17371; font-src 'self' data:; connect-src 'self' blob: data: https://worldcodes.online https://download.xmimage2.cc.cd http://127.0.0.1:23210 http://127.0.0.1:17371 __R2_ORIGIN__; worker-src 'self' blob:; child-src 'none'; frame-src 'none'; manifest-src 'self'"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	# BEGIN FIXED IMAGE RESULT PROXY
	# Only a public image UUID can reach this fixed origin; caller credentials are removed.
	@canvasImageResult {
		method GET
		path_regexp canvasImageResult ^/v1/images/content/pandatk/([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$
		expression `{http.request.uri.query} == ""`
	}
	handle @canvasImageResult {
		header Cache-Control "private, no-store"
		rewrite * /r2/images/{re.canvasImageResult.1}
		reverse_proxy https://download.xmimage2.cc.cd {
			header_up Host download.xmimage2.cc.cd
			header_up -Authorization
			header_up -Cookie
			header_up -Origin
			header_up -Referer
			header_down -Set-Cookie
			transport http {
				dial_timeout 10s
				response_header_timeout 30s
			}
		}
	}
	# END FIXED IMAGE RESULT PROXY

	# Exactly one local Relay upstream remains in the blue-green contract.
	@canvasAPI expression `
	(method('GET') && path('/v1/models', '/v1/images/content/*', '/v1/images/tasks/*', '/v1/videos/*')) ||
	(method('POST') && path('/v1/responses', '/v1/audio/speech', '/v1/images/generations', '/v1/images/edits', '/v1/videos', '/v1/media/uploads/presign', '/v1/media/uploads/*', '/v1beta/models/*')) ||
	(method('DELETE') && path('/v1/media/uploads/*'))
	`
	handle @canvasAPI {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:__RELAY_PORT__
	}

	# Never let an unapproved API path fall through to the SPA shell.
	@apiNamespace path /api /api/* /v1 /v1/* /v1beta /v1beta/*
	handle @apiNamespace {
		respond 404
	}

	@immutable path /assets/*
	handle @immutable {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@spa method GET HEAD
	handle @spa {
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}

	handle {
		respond 404
	}

	log {
		output file /var/log/caddy/worldcodes-canvas.log {
			roll_size 50mb
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
